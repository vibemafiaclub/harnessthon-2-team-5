{
  "$schema_note": "디자인 토큰 단일 정본. HTML 초안은 CSS 변수로, Figma 는 Variables 로 이 파일 하나를 소비한다. 값은 design-tokens 단계에서 사용자 선택으로 확정된다. 여기 있는 값은 자리표시자다. 분류 체계는 팀 디자이너의 prd-to-design-guide 스킬(6카테고리)을 채택했다. 각 그룹의 rationale 은 '왜 이 값인가' 를 brief.md 의 근거(반응 정본 R-/W-, 적합성 단서, PRD 원문)와 연결해 적는다.",
  "meta": {
    "project": "",
    "chosen_set": "",
    "platform": "mobile-first | desktop-first | responsive",
    "emotion_keywords_internal": ["", "", ""],
    "wcag_checked_at": "",
    "source_brief": "design/brief.md"
  },
  "color": {
    "rationale": "",
    "primitive": {
      "primary":   { "50": "", "100": "", "300": "", "500": "", "700": "", "900": "" },
      "secondary": { "100": "", "500": "", "700": "" },
      "neutral":   { "0": "#FFFFFF", "50": "", "100": "", "200": "", "300": "", "500": "", "700": "", "900": "" }
    },
    "semantic": {
      "bg":      { "page": "{color.primitive.neutral.0}", "surface": "", "elevated": "" },
      "text":    { "primary": "", "secondary": "", "disabled": "", "on-primary": "", "link": "" },
      "border":  { "default": "", "strong": "", "focus": "" },
      "brand":   { "default": "{color.primitive.primary.500}", "hover": "{color.primitive.primary.700}", "subtle": "{color.primitive.primary.50}" },
      "accent":  { "default": "{color.primitive.secondary.500}", "subtle": "{color.primitive.secondary.100}" },
      "feedback": {
        "_note": "각 항목은 배경+텍스트 쌍. 텍스트/배경 대비 4.5:1 이상 필수.",
        "success": { "bg": "", "text": "" },
        "warning": { "bg": "", "text": "" },
        "error":   { "bg": "", "text": "" },
        "info":    { "bg": "", "text": "" }
      },
      "status": {
        "_note": "PRD 에서 도출된 도메인 상태 개수·이름대로 키를 만든다(brief.md §7). 아래는 자리표시자. 각 항목은 배경+텍스트 쌍.",
        "state-1": { "bg": "", "text": "" },
        "state-2": { "bg": "", "text": "" },
        "state-3": { "bg": "", "text": "" }
      }
    },
    "wcag": {
      "_note": "design-worker 가 채운다. 쌍 이름: 측정 대비율 / PASS·FAIL",
      "text.primary/bg.page": "",
      "text.secondary/bg.page": "",
      "text.on-primary/brand.default": ""
    }
  },
  "typography": {
    "rationale": "",
    "family": {
      "body": "",
      "display": "",
      "mono": "",
      "_note": "한글 서비스는 한글 웹폰트 우선. 3단계 Figma 구현 시 listAvailableFontsAsync 로 로드 가능 여부 확인, 불가 시 fallback 으로 교체하고 가정 로그 기록.",
      "fallback": ""
    },
    "scale": {
      "_note": "size(px) / lineHeight(배수) / weight / letterSpacing(em). 모바일·데스크톱이 다르면 desktop 필드에 크기만 별도 기입.",
      "display":    { "size": "", "lineHeight": 1.2,  "weight": 700, "letterSpacing": "-0.02em", "desktop": "" },
      "heading-1":  { "size": "", "lineHeight": 1.25, "weight": 700, "letterSpacing": "-0.01em", "desktop": "" },
      "heading-2":  { "size": "", "lineHeight": 1.3,  "weight": 600, "letterSpacing": "0",       "desktop": "" },
      "heading-3":  { "size": "", "lineHeight": 1.35, "weight": 600, "letterSpacing": "0",       "desktop": "" },
      "body-large": { "size": "", "lineHeight": 1.5,  "weight": 400, "letterSpacing": "0" },
      "body":       { "size": "", "lineHeight": 1.5,  "weight": 400, "letterSpacing": "0" },
      "body-small": { "size": "", "lineHeight": 1.5,  "weight": 400, "letterSpacing": "0" },
      "caption":    { "size": "", "lineHeight": 1.4,  "weight": 400, "letterSpacing": "0.01em" },
      "overline":   { "size": "", "lineHeight": 1.4,  "weight": 600, "letterSpacing": "0.08em" }
    }
  },
  "spacing": {
    "rationale": "",
    "unit": 4,
    "scale": { "0": 0, "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
    "usage": {
      "_note": "각 값이 어디에 쓰이는지. 키는 scale 키.",
      "1": "아이콘-텍스트 간격",
      "2": "",
      "4": "컴포넌트 내부 패딩 기본",
      "6": "",
      "8": "섹션 간 간격"
    },
    "component_padding": {
      "button":  { "x": "{spacing.scale.4}", "y": "{spacing.scale.3}" },
      "card":    { "x": "{spacing.scale.4}", "y": "{spacing.scale.4}" },
      "input":   { "x": "{spacing.scale.3}", "y": "{spacing.scale.3}" },
      "modal":   { "x": "{spacing.scale.6}", "y": "{spacing.scale.6}" },
      "list-row":{ "x": "{spacing.scale.4}", "y": "{spacing.scale.3}" }
    }
  },
  "radius": {
    "rationale": "",
    "scale": { "none": 0, "sm": 4, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "full": 9999 },
    "usage": {
      "button": "", "card": "", "input": "", "badge": "", "avatar": "", "modal": "", "chip": ""
    },
    "concentric_rule": "outerRadius = innerRadius + padding (중첩 요소는 이 규칙으로 계산, A단계 검사 대상)"
  },
  "elevation": {
    "rationale": "",
    "scale": {
      "none": "none",
      "sm":   { "offset": "0 1px", "blur": 2,  "spread": 0, "color": "{color.primitive.neutral.900}", "opacity": 0.06, "usage": "미묘한 깊이" },
      "md":   { "offset": "0 4px", "blur": 12, "spread": 0, "color": "{color.primitive.neutral.900}", "opacity": 0.10, "usage": "카드·드롭다운" },
      "lg":   { "offset": "0 12px","blur": 32, "spread": 0, "color": "{color.primitive.neutral.900}", "opacity": 0.16, "usage": "모달·오버레이" }
    }
  },
  "icon": {
    "rationale": "",
    "style": "outlined | filled | duotone",
    "size": { "sm": 16, "md": 20, "lg": 24 },
    "stroke": { "_note": "본문 weight 에 맞춘다. 예: 400 → 1.5px", "width": "" }
  },
  "layout": {
    "grid_unit": 4,
    "content_max_width": "",
    "touch_target_min": 44,
    "viewport": { "mobile": 360, "desktop": 1280 }
  }
}
