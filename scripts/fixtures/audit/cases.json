 {
  "name": "네이밍 2규칙 분리 — semantic(컨테이너·한글·Tab/home 허용) / auto(Frame 12)",
  "rules": [
   {
    "id": "layer-naming-semantic",
    "severity": "warning",
    "stage": [
     "design"
    ],
    "applies_to": {
     "node_types": [
      "FRAME",
      "COMPONENT",
      "COMPONENT_SET",
      "INSTANCE"
     ],
     "descendants_only": true,
     "exclude_instance_children": true
    },
    "check": {
     "type": "name_pattern",
     "allow": "^[A-Z][^/]*(/[^/]+)*$",
     "allow_node_types": [
      "FRAME",
      "COMPONENT",
      "COMPONENT_SET",
      "INSTANCE"
     ]
    }
   },
   {
    "id": "layer-naming-auto",
    "severity": "warning",
    "stage": [
     "design"
    ],
    "applies_to": {},
    "check": {
     "type": "name_pattern",
     "deny": [
      "^(Frame|Group|Rectangle|Ellipse|Vector|Line)\\s*\\d*$"
     ]
    }
   }
  ],
