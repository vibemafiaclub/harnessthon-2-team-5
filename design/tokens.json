{
  "meta": {
    "project": "청첩장모임 스케줄러",
    "chosen_set": "SET-B",
    "platform": "mobile-first",
    "emotion_keywords_internal": [
      "부드러운",
      "여유로운 위계",
      "고채도"
    ],
    "wcag_checked_at": "2026-09-05",
    "source_brief": "design/brief.md"
  },
  "color": {
    "rationale": "색온도(§3)는 아직 유보 상태이므로 청록 계열로 대안을 제시하되 RULE-02의 고채도 조건과 웨딩 클리셰 회피(§11)를 함께 지킨다. border.default(neutral.200)는 청록 기운 회색 계열(hue)을 유지한 채 명도만 낮춰 bg.page 대비 대비 하한(3:1) 충족을 위해 조정했다(1.26:1→3.10:1).",
    "primitive": {
      "primary": {
        "50": "#EAF7F5",
        "100": "#D2EFEA",
        "300": "#4DBFA8",
        "500": "#0D7A64",
        "700": "#095C4D",
        "900": "#063D33"
      },
      "secondary": {
        "100": "#FFE3D9",
        "500": "#FF6F45",
        "700": "#C94A26"
      },
      "neutral": {
        "0": "#FFFFFF",
        "50": "#F8F9F8",
        "100": "#EFF1F0",
        "200": "#DCE3E2",
        "300": "#CDD1CE",
        "400": "#909391",
        "500": "#6D7570",
        "700": "#414944",
        "900": "#171B18"
      }
    },
    "semantic": {
      "bg": {
        "page": "{color.primitive.neutral.0}",
        "surface": "{color.primitive.neutral.50}",
        "elevated": "{color.primitive.neutral.0}"
      },
      "text": {
        "primary": "{color.primitive.neutral.900}",
        "secondary": "{color.primitive.neutral.700}",
        "disabled": "{color.primitive.neutral.300}",
        "on-primary": "{color.primitive.neutral.0}",
        "link": "{color.primitive.primary.700}"
      },
      "border": {
        "default": "{color.primitive.neutral.400}",
        "strong": "{color.primitive.neutral.500}",
        "focus": "{color.primitive.primary.500}"
      },
      "brand": {
        "default": "{color.primitive.primary.500}",
        "hover": "{color.primitive.primary.700}",
        "subtle": "{color.primitive.primary.50}"
      },
      "accent": {
        "default": "{color.primitive.secondary.500}",
        "subtle": "{color.primitive.secondary.100}"
      },
      "feedback": {
        "success": {
          "bg": "#E6F5EA",
          "text": "#146C2E"
        },
        "warning": {
          "bg": "#FFF3DC",
          "text": "#8A5A00"
        },
        "error": {
          "bg": "#FCE9E6",
          "text": "#B03A22"
        },
        "info": {
          "bg": "#E7F1FD",
          "text": "#1849A9"
        }
      },
      "status": {
        "_note": "brief §7: 진행 상태 4종(대기/확정임박/확정/완료)",
        "대기": {
          "bg": "#EFF1F0",
          "text": "#414944"
        },
        "확정임박": {
          "bg": "#FFF3DC",
          "text": "#8A5A00"
        },
        "확정": {
          "bg": "#E6F5EA",
          "text": "#146C2E"
        },
        "완료": {
          "bg": "#E6EEEC",
          "text": "#2A4A44"
        }
      },
      "response": {
        "_note": "brief §7: 회신 응답 3종(가능/불가능/미회신)",
        "가능": {
          "bg": "#E6F5EA",
          "text": "#146C2E"
        },
        "불가능": {
          "bg": "#FCE9E6",
          "text": "#B03A22"
        },
        "미회신": {
          "bg": "#EFF1F0",
          "text": "#414944"
        }
      },
      "alert": {
        "_note": "brief §7: 경보 2종 — RULE-01 예외(제목 위계 아닌 상태 신호)",
        "겹침경고": {
          "bg": "#FFF3DC",
          "text": "#8A5A00"
        },
        "마감임박": {
          "bg": "#FCE9E6",
          "text": "#B03A22"
        }
      }
    },
    "wcag": {
      "text.primary/bg.page": "17.41:1 / PASS",
      "text.primary/bg.surface": "16.49:1 / PASS",
      "text.secondary/bg.page": "9.29:1 / PASS",
      "text.on-primary/brand.default": "5.27:1 / PASS",
      "text.link/bg.page": "7.93:1 / PASS",
      "border.default/bg.page": "3.10:1 / PASS",
      "border.strong/bg.page": "4.74:1 / PASS"
    }
  },
  "typography": {
    "rationale": "동일한 중성 산세리프 방향(RULE-04)에서 제목-본문 배수를 완만하게 해 부드러운 위계를 만든다(W-2-1 방향은 유지).",
    "family": {
      "body": "Noto Sans KR",
      "display": "Noto Sans KR",
      "mono": "SFMono-Regular, Menlo, monospace",
      "_note": "ASSUMPTION: 외부 웹폰트 CDN 금지 제약(§공통 제약)으로 HTML 산출물은 fallback 스택만 렌더한다. Noto Sans KR 은 3단계 Figma 구현 시 사용 가능 여부를 확인한다.",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif"
    },
    "scale": {
      "display": {
        "size": 30,
        "lineHeight": 1.3,
        "weight": 700,
        "letterSpacing": "-0.01em"
      },
      "heading-1": {
        "size": 25,
        "lineHeight": 1.35,
        "weight": 700,
        "letterSpacing": "0"
      },
      "heading-2": {
        "size": 20,
        "lineHeight": 1.4,
        "weight": 600,
        "letterSpacing": "0"
      },
      "heading-3": {
        "size": 17,
        "lineHeight": 1.4,
        "weight": 600,
        "letterSpacing": "0"
      },
      "body-large": {
        "size": 17,
        "lineHeight": 1.6,
        "weight": 400,
        "letterSpacing": "0"
      },
      "body": {
        "size": 15,
        "lineHeight": 1.6,
        "weight": 400,
        "letterSpacing": "0"
      },
      "body-small": {
        "size": 13,
        "lineHeight": 1.6,
        "weight": 400,
        "letterSpacing": "0"
      },
      "caption": {
        "size": 12,
        "lineHeight": 1.5,
        "weight": 400,
        "letterSpacing": "0.01em"
      },
      "overline": {
        "size": 11,
        "lineHeight": 1.5,
        "weight": 600,
        "letterSpacing": "0.06em"
      }
    }
  },
  "spacing": {
    "rationale": "여유 있는 레이아웃 정본(대조표 §3, 공통 고정)을 더 넉넉하게 적용해 부드러운 인상을 강화한다.",
    "unit": 4,
    "scale": {
      "0": 0,
      "0.5": 2,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80,
      "24": 96
    },
    "usage": {
      "1": "아이콘-텍스트 간격",
      "2": "칩·배지 내부 패딩",
      "4": "컴포넌트 내부 패딩 기본",
      "6": "카드 간 간격",
      "8": "섹션 간 간격"
    },
    "component_padding": {
      "button": {
        "x": "{spacing.scale.5}",
        "y": "{spacing.scale.4}"
      },
      "card": {
        "x": "{spacing.scale.5}",
        "y": "{spacing.scale.5}"
      },
      "input": {
        "x": "{spacing.scale.4}",
        "y": "{spacing.scale.4}"
      },
      "modal": {
        "x": "{spacing.scale.6}",
        "y": "{spacing.scale.6}"
      },
      "list-row": {
        "x": "{spacing.scale.5}",
        "y": "{spacing.scale.4}"
      }
    }
  },
  "radius": {
    "rationale": "같은 RULE-03(형태) 미확정 구간에서 더 큰 라운딩으로 '둥근 카드' 반응(R-G-02)을 강하게 해석한다.",
    "scale": {
      "none": 0,
      "sm": 6,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "2xl": 28,
      "full": 9999
    },
    "usage": {
      "button": "lg",
      "card": "xl",
      "input": "lg",
      "badge": "full",
      "avatar": "full",
      "modal": "2xl",
      "chip": "full"
    },
    "concentric_rule": "outerRadius = innerRadius + padding (예: 버튼 radius 16 + 카드 패딩 20 → 카드 radius 20 이상)"
  },
  "elevation": {
    "rationale": "둥근 카드 선호(R-G-02)를 그림자에도 반영해 더 부드럽고 넓게 퍼지는 음영을 쓴다.",
    "scale": {
      "none": "none",
      "sm": {
        "offset": "0 2px",
        "blur": 6,
        "spread": 0,
        "color": "{color.primitive.neutral.900}",
        "opacity": 0.07,
        "usage": "미묘한 깊이"
      },
      "md": {
        "offset": "0 6px",
        "blur": 18,
        "spread": 0,
        "color": "{color.primitive.neutral.900}",
        "opacity": 0.12,
        "usage": "카드·드롭다운"
      },
      "lg": {
        "offset": "0 16px",
        "blur": 40,
        "spread": 0,
        "color": "{color.primitive.neutral.900}",
        "opacity": 0.18,
        "usage": "모달·오버레이"
      }
    }
  },
  "icon": {
    "rationale": "둥근 카드 선호(R-G-02)와 부드러운 인상에 맞춰 두 톤 채움 아이콘으로 여백감을 준다.",
    "style": "duotone",
    "size": {
      "sm": 16,
      "md": 20,
      "lg": 24
    },
    "stroke": {
      "width": "1px(보조 외곽선, duotone은 면 중심)"
    }
  },
  "layout": {
    "grid_unit": 4,
    "content_max_width": "480px",
    "touch_target_min": 44,
    "viewport": {
      "mobile": 360,
      "desktop": 1280
    }
  }
}
